# ─── SERVER ───────────────────────────────
PORT=3001

# ─── GMAIL API (for sending campaigns) ───
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3001/auth/callback

# ─── SYSTEM EMAIL (for sending verification codes) ───
# Create a dedicated Gmail for this e.g. noreply.mailblastpro@gmail.com
# Use Gmail App Password (not your real password)
# Get App Password: myaccount.google.com → Security → App Passwords
SYSTEM_EMAIL=your_system_email@gmail.com
SYSTEM_EMAIL_PASSWORD=your_gmail_app_password

# ─── SECURITY ─────────────────────────────
# Make this a long random string e.g. "xK9#mP2$qL7@nR4"
SECRET_SALT=make_this_a_long_random_string
